APP_ENV=development
DATABASE_URL=sqlite:///./data/enotes.db
# Generate a unique random value with at least 32 characters before deployment.
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_TOKEN_MINUTES=30
PUBLIC_APP_URL=enotes://reset-password
DEV_MAIL_SINK=true
# Optional SMTP. Production password-reset delivery requires all SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Resend is recommended on Render Free because it sends over HTTPS (port 443).
# Configure only after creating an API key and verifying the sender address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
