APP_ENV=development
DATABASE_URL=sqlite:///./data/enotes.db
# Generate a unique random value with at least 32 characters before deployment.
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_TOKEN_MINUTES=30
PUBLIC_APP_URL=enotes://reset-password
DEV_MAIL_SINK=true
# Optional SMTP. Production password-reset delivery requires all SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Resend is recommended on Render Free because it sends over HTTPS (port 443).
# Configure only after creating an API key and verifying the sender address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Generate a new base64url value from 32 random bytes and store it only in the backend secret manager.
AI_CREDENTIALS_ENCRYPTION_KEY=
# Optional service-managed provider keys. User-provided keys remain encrypted per ENotes account.
GEMINI_API_KEY=
GROQ_API_KEY=
GLM_API_KEY=
# Empty by default: only IDs reviewed and verified by the service operator for free eligibility belong here.
AI_VERIFIED_FREE_MODELS={"groq":[],"gemini":[],"glm":[]}
# Optional provider/model IDs with verified paid pricing; conflicts with the free list are treated as unknown.
AI_VERIFIED_PAID_MODELS={"groq":[],"gemini":[],"glm":[]}
